{
  "name": "carglance",
  "author": "Matthias Gellrich",
  "version": "1.1.0",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "CarGlance",
    "uuid": "974f806a-b190-45eb-8d2f-4b53da551289",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.pleos.ai"
          ]
        }
      }
    ],
    "messageKeys": [
      "REFRESH",
      "STATUS",
      "ERROR",
      "NAME",
      "LOCKED",
      "PLUGGED",
      "CHARGING",
      "CHARGE_STATUS",
      "SOC",
      "REMAIN_MIN",
      "DATA_TIME",
      "VEHICLES",
      "VEHICLE_INDEX",
      "SELECT_VEHICLE"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOCK",
          "file": "images/lock.png",
          "storageFormat": "pbi"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_PLUG",
          "file": "images/plug.png",
          "storageFormat": "pbi"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_BOLT",
          "file": "images/bolt.png",
          "storageFormat": "pbi"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_REFRESH",
          "file": "images/refresh.png",
          "storageFormat": "pbi"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_CAR",
          "file": "images/car.png",
          "storageFormat": "pbi"
        }
      ]
    }
  }
}
